+            assert isinstance(self.segment_stop_step, int) and self.segment_stop_step > 0, (
+                f"segment_stop_step must be a positive int, got {self.segment_stop_step}"
+            )
+            print(f"Segment stop step: {self.segment_stop_step} (schedule horizon stays {total_training_steps})")
+
         try:
             OmegaConf.set_struct(self.config, True)
             with open_dict(self.config):
