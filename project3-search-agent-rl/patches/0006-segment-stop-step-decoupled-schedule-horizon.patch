+                # total_training_steps keeps defining the scheduler horizon so the LR schedule
+                # is identical across segments; segment_stop_step only bounds this segment's
+                # execution and reuses the same save-and-return path as the final step.
+                is_segment_stop = self.segment_stop_step is not None and self.global_steps >= self.segment_stop_step
