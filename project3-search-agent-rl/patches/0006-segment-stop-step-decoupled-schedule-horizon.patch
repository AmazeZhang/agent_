         print(f"Total training steps: {self.total_training_steps}")
 
+        # P3 patch 0006: segment_stop_step decouples the *stop point* of this training
+        # segment from the *schedule horizon* (total_training_steps). The LR scheduler is
+        # always built for the full horizon (e.g. 300), while segment_stop_step ends the
+        # current segment early (e.g. 50/100/300) after completing the step and saving a
