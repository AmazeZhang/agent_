+def compute_grpo_trajectory_return_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    traj_index: np.ndarray,
+    epsilon: float = 1e-6,
+    norm_adv_by_std_in_grpo: bool = True,
+):
+    """Search-aware GRPO v1 trajectory-return advantage (P3 patch 0008).
+
+    Fixes the per-record normalization of compute_grpo_outcome_advantage for
+    step-attributed rewards: with the v1 step reward, each step record carries
+    only a PART of its trajectory's reward (a search step +0.15, the terminal
+    step +1.00/+1.30), and normalizing every record's partial sum inside the
+    uid group lets a useful search step score a NEGATIVE advantage against the
+    terminal score of the same trajectory. This function instead:
+
+      1. each record's reward          = token_level_rewards.sum(-1) per record
+      2. trajectory return             = sum over that traj_uid's records
+      3. group                         = the 5 trajectory returns of one uid
+                                         (GRPO n=5; fail-closed: one traj_uid
+                                         maps to exactly one uid)
+      4. GRPO mean/std over trajectory returns (len==1 group -> mean 0/std 1,
+                                         mirroring compute_grpo_outcome_advantage)
+      5. trajectory advantage          = (return - mean) / (std + epsilon),
+                                         broadcast to EVERY record of the
+                                         trajectory (all its model-action tokens)
+      6. adv.unsqueeze(-1) * response_mask: Observation tokens stay masked
+                                         (response_mask is the policy loss mask
+                                         tail: observation positions are 0)
+
+    Returns (advantages, returns), both shaped (bs, response_length).
+    """
+    scores = token_level_rewards.sum(dim=-1)  # per-record reward
+
+    with torch.no_grad():
+        bsz = scores.shape[0]
+        # 1+2: trajectory return per traj_uid, with uid-consistency fail-closed
+        traj2uid: dict = {}
+        traj2score: dict = defaultdict(float)
+        for i in range(bsz):
+            uid = index[i]
+            tid = traj_index[i]
+            if tid in traj2uid and traj2uid[tid] != uid:
+                raise ValueError(
+                    f"traj_uid {tid} maps to multiple uids ({traj2uid[tid]} and {uid}): "
+                    "trajectory grouping is broken"
+                )
+            traj2uid[tid] = uid
+            traj2score[tid] += float(scores[i])
+
+        # 3: group the DISTINCT trajectory returns of each uid
+        uid2scores: dict = defaultdict(list)
+        for tid, uid in traj2uid.items():
+            uid2scores[uid].append(traj2score[tid])
+        id2mean = {}
+        id2std = {}
+        for idx in uid2scores:
+            if len(uid2scores[idx]) == 1:
+                id2mean[idx] = torch.tensor(0.0)
+                id2std[idx] = torch.tensor(1.0)
+            elif len(uid2scores[idx]) > 1:
+                id2mean[idx] = torch.mean(torch.tensor(uid2scores[idx]))
+                id2std[idx] = torch.std(torch.tensor([uid2scores[idx]]))
+            else:
+                raise ValueError(f"no score in prompt index: {idx}")
+
+        # 4+5+6: trajectory advantage broadcast to all records of the trajectory
+        traj_adv = {}
+        for tid, ret in traj2score.items():
+            uid = traj2uid[tid]
+            if norm_adv_by_std_in_grpo:
+                traj_adv[tid] = (ret - id2mean[uid]) / (id2std[uid] + epsilon)
+            else:
+                traj_adv[tid] = ret - id2mean[uid]
+        advantages = torch.zeros_like(scores)
+        for i in range(bsz):
+            advantages[i] = traj_adv[traj_index[i]]
+        advantages = advantages.unsqueeze(-1) * response_mask
+
+    return advantages, advantages
+
+
