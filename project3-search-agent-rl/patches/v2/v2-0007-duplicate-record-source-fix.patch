+def _build_padding_rows(data: DataProto, to_add: int) -> DataProto:
+    """Build `to_add` synthetic rows that complete the batch to a DP-divisible size.
+
+    Copy-padding real rows would duplicate training records -- a training record
+    is identified by (uid, traj_uid, env_step), and each env step emits exactly
+    ONE record type -- duplicating a row would double-count that step's reward
+    and policy gradient. The padding rows are instead schema-complete copies
+    that are inert by construction:
+
+      - attention_mask keeps ONE attended token at position 0 (a PROMPT
+        position): the FSDP actor's unpad (`attention_mask.nonzero()`) must not
+        produce an empty sequence -- an all-zero row crashes the HF forward
+        with "cannot reshape tensor of 0 elements" (observed 2026-08-23a
+        smoke, actor_rollout_compute_log_prob). The response part stays
+        all-zero -> response_mask all-zero -> zero policy loss and zero
+        global-token accounting (nothing placed on the reward tensor); the
+        attended prompt token is masked out of every loss by the response
+        mask, so its computed log probs are inert.
+      - loss_mask (multi-turn batches) zeroed: copies of row 0 would otherwise
+        carry row 0's loss_mask and contribute a real policy gradient.
+      - unique synthetic uid/traj_uid "__pad__{k}", env_step=-1, is_padding=True
+        -> each padding row forms its own size-1 GRPO group (mean 0 / std 1
+        convention) with reward 0 -> advantage exactly 0.0
+      - search_v1=None -> the v2 reward manager skips them; a REAL record
+        missing search_v1 still raises (fail-closed)
+
+    DataProto.concat requires identical key sets, so the caller must mark
+    `is_padding` on `data` itself (this function adds it if absent).
+    """
+    if to_add <= 0:
+        raise ValueError(f"to_add must be positive, got {to_add}")
+    # schema snapshot (advanced indexing -> fresh tensors/arrays, no aliasing)
+    proto = data.select_idxs([0] * to_add)
+    if "is_padding" not in data.non_tensor_batch:
+        data.non_tensor_batch["is_padding"] = np.zeros(len(data), dtype=bool)
+    proto.non_tensor_batch["is_padding"] = np.ones(to_add, dtype=bool)
+    for k in range(to_add):
+        proto.non_tensor_batch["uid"][k] = f"__pad__{k}"
+        proto.non_tensor_batch["traj_uid"][k] = f"__pad__{k}"
+    proto.non_tensor_batch["env_step"] = np.full(to_add, -1, dtype=np.int64)
+    if "search_v1" in proto.non_tensor_batch:
+        proto.non_tensor_batch["search_v1"][:] = None
+    # Single attended token at position 0 (prompt region): keeps the actor
+    # unpad from producing an empty sequence, response part stays all-zero.
+    proto.batch["attention_mask"].zero_()
+    proto.batch["attention_mask"][:, 0] = 1
+    if "loss_mask" in proto.batch:
+        # multi-turn batches carry row-0's copied loss_mask -> zero it, else
+        # padding rows would contribute a real policy gradient.
+        proto.batch["loss_mask"].zero_()
+    return proto
+
+
+def assert_unique_training_records(data: DataProto) -> None:
+    """Fail-closed invariant: no two TRAINING records share (uid, traj_uid, env_step).
+
+    A training record is the batch row produced by one model action at one env
+    step of one trajectory. Each env step emits exactly one record type, so
+    (uid, traj_uid, env_step) is the complete identity of a training record; a
+    duplicate identity means batch assembly appended the same step twice
+    (copy-padding or a double append), which double-counts that step's reward
+    and policy gradient. Synthetic padding rows (is_padding=True) are inert and
+    excluded. Must be called AFTER batch assembly and BEFORE reward placement
+    and advantage computation.
+    """
+    if len(data) == 0:
+        return
+    uids = data.non_tensor_batch["uid"]
+    trajs = data.non_tensor_batch["traj_uid"]
+    steps = data.non_tensor_batch["env_step"]
+    padding = data.non_tensor_batch.get("is_padding")
+    first_index: dict = {}
+    for i in range(len(data)):
+        if padding is not None and bool(padding[i]):
+            continue
+        key = (uids[i], trajs[i], int(steps[i]))
+        if key in first_index:
+            raise RuntimeError(
+                f"duplicate training record identity (uid={key[0]}, traj_uid={key[1]}, "
+                f"env_step={key[2]}): records {first_index[key]} and {i} are the same "
+                "trajectory step; batch assembly must append each env step exactly once"
+            )
+        first_index[key] = i
+
