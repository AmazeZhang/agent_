+    def _apply_search_aware_v2(self, data: DataProto, reward_tensor: torch.Tensor) -> None:
+        """Step-attributed v2 reward placement + per-trajectory component recording.
+
+        Fail-closed: every record must carry env-computed `search_v1` metadata
+        (the v2 profile enables it on both the env and the reward manager); a
+        missing dict is a config error, not a zero reward.
+
+        Episode audit is per traj_uid (frozen v2 semantics): one traj_uid is ONE
+        real trajectory, while the same question (uid) has 5 distinct traj_uids
+        (GRPO n=5). Accumulating by uid would merge 5 trajectories into one
+        fake "episode" and hide per-trajectory totals, so:
+          - search_v1_episode records the 8 components per traj_uid (one entry
+            per real trajectory, carrying its uid)
+          - search_v1_group additionally rolls the same components up per uid
+            (informational only; never a substitute for the episode audit)
+        Fail-closed: a traj_uid observed under two different uids is an error.
+
+        All values are env-computed (searchr1_repro/search_v2_reward.py); the
+        manager only PLACES them at the right token position and audits the
+        sum-consistency (component sum == placed sum == trajectory return) in
+        exact integer cents.
+        """
+        from searchr1_repro.search_v2_reward import (
+            ANSWER_LEAK_C,
+            EVIDENCE_HIT_C,
+            INVALID_C,
+            REDUNDANT_C,
+            reward_float,
+        )
+
+        # traj_uid -> {placed_cents, per-step component cents, record count, uid}
+        acc: dict[str, dict] = {}
+        # uid -> record indices (for the informational group rollup)
+        uid_records: dict[str, list[int]] = {}
+        # per-record audit: trajectory-level component dict (filled per traj below)
+        data.non_tensor_batch['search_v1_episode'] = np.empty(len(data), dtype=object)
+        data.non_tensor_batch['search_v1_group'] = np.empty(len(data), dtype=object)
+
+        for i in range(len(data)):
+            data_item = data[i]
+            sv = data_item.non_tensor_batch.get('search_v1')
+            if sv is None:
+                raise RuntimeError(
+                    "search_aware_step_reward=true but record has no search_v1 metadata; "
+                    "env.search_aware_step_reward must also be true (fail-closed)"
+                )
+            prompt_ids = data_item.batch['prompts']
+            prompt_length = prompt_ids.shape[-1]
+            valid_response_length = int(data_item.batch['attention_mask'][prompt_length:].sum())
+            if valid_response_length <= 0:
+                raise RuntimeError("v2 step reward on an empty response record")
+            if sv.get("terminal"):
+                placed_c = int(sv.get("answer_reward_c", 0)) + int(sv.get("format_reward_c", 0)) + int(sv.get("sce_c", 0))
+            else:
+                placed_c = int(sv.get("step_shaping_c", 0))
+            reward_tensor[i, valid_response_length - 1] = reward_float(placed_c)
+
+            uid = data_item.non_tensor_batch.get('uid')
+            if uid is None:
+                raise RuntimeError("v2 step reward requires uid grouping metadata")
+            traj_uid = data_item.non_tensor_batch.get('traj_uid')
+            if traj_uid is None:
+                raise RuntimeError("v2 step reward requires traj_uid grouping metadata")
+            bucket = acc.setdefault(traj_uid, {"placed_cents": 0, "components": {
+                "answer_reward_c": 0, "format_reward_c": 0, "evidence_hit_reward_c": 0,
+                "searched_correct_bonus_c": 0, "invalid_penalty_c": 0,
+                "redundant_penalty_c": 0, "answer_leak_penalty_c": 0,
+            }, "records": [], "uid": None})
+            if bucket["uid"] is None:
+                bucket["uid"] = uid
+            elif bucket["uid"] != uid:
+                raise RuntimeError(
+                    f"traj_uid {traj_uid} maps to multiple uids "
+                    f"({bucket['uid']} and {uid}): trajectory grouping is broken"
+                )
+            uid_records.setdefault(uid, []).append(i)
+            bucket["placed_cents"] += placed_c
+            bucket["records"].append(i)
+            comps = bucket["components"]
+            if sv.get("terminal"):
+                comps["answer_reward_c"] += int(sv.get("answer_reward_c", 0))
+                comps["format_reward_c"] += int(sv.get("format_reward_c", 0))
+                comps["searched_correct_bonus_c"] += int(sv.get("sce_c", 0))
+            else:
+                if sv.get("evidence_credit"):
+                    comps["evidence_hit_reward_c"] += EVIDENCE_HIT_C
+                if sv.get("invalid_or_error"):
+                    comps["invalid_penalty_c"] += INVALID_C
+                if sv.get("redundant_search"):
+                    comps["redundant_penalty_c"] += REDUNDANT_C
+                if sv.get("answer_leak"):
+                    comps["answer_leak_penalty_c"] += ANSWER_LEAK_C
+
+        # per-trajectory component sum == per-record placed score sum (exact cents)
+        for traj_uid, bucket in acc.items():
+            comps = bucket["components"]
+            comp_sum = sum(comps.values())
+            if comp_sum != bucket["placed_cents"]:
+                raise RuntimeError(
+                    f"v2 reward sum-consistency failed for traj_uid {traj_uid} "
+                    f"(uid {bucket['uid']}): components {comps} sum to {comp_sum}, "
+                    f"placed {bucket['placed_cents']}"
+                )
+            episode = dict(comps)
+            episode["total_reward_c"] = comp_sum
+            episode["n_records"] = len(bucket["records"])
+            episode["uid"] = bucket["uid"]
+            # attach to every record of this trajectory so the audit records it
+            for ridx in bucket["records"]:
+                data.non_tensor_batch['search_v1_episode'][ridx] = episode
+
+        # per-uid rollup (informational; the traj-level audit above is canonical)
+        group_acc: dict[str, dict] = {}
+        for traj_uid, bucket in acc.items():
+            g = group_acc.setdefault(bucket["uid"], {
+                "components": {k: 0 for k in ("answer_reward_c", "format_reward_c",
+                                              "evidence_hit_reward_c", "searched_correct_bonus_c",
+                                              "invalid_penalty_c", "redundant_penalty_c",
+                                              "answer_leak_penalty_c")},
+                "n_trajectories": 0, "traj_uids": [],
+            })
+            for k, v in bucket["components"].items():
+                g["components"][k] += v
+            g["n_trajectories"] += 1
+            g["traj_uids"].append(traj_uid)
+        for uid, g in group_acc.items():
+            group = dict(g["components"])
+            group["total_reward_c"] = sum(g["components"].values())
+            group["uid"] = uid
+            group["n_trajectories"] = g["n_trajectories"]
+            group["traj_uids"] = sorted(g["traj_uids"])
+            for ridx in uid_records.get(uid, []):
+                data.non_tensor_batch['search_v1_group'][ridx] = group
+
+        # sanity: every batch record belongs to exactly one traj accumulation
+        if sum(len(b["records"]) for b in acc.values()) != len(data):
+            raise RuntimeError("v2 step reward traj_uid accounting mismatch")
