+def passthrough_projection(actions: List[str]) -> Tuple[List[str], List[bool]]:
+    """Official-loose projection: raw actions pass through untouched, all valid.
+
+    Selected via ``config.env.projection=official`` (patch 0005). The raw LLM
+    action text reaches the underlying skyrl SearchEnv byte-identical and every
+    action is marked valid — there is no invalid-action concept on the official
+    line, matching the official-line evaluation harness. The invalid-action
+    penalty is disabled separately via
+    ``actor_rollout_ref.actor.use_invalid_action_penalty=false``.
+    """
+
+    return list(actions), [True] * len(actions)
+
